# Copiar a `.env` (sin punto en este archivo) y completar los valores.
# NO versionar `.env`. Ningún valor de este ejemplo es un secreto real.
POSTGRES_USER=libreria
POSTGRES_PASSWORD=cambiar_por_la_contrasena_local
POSTGRES_DB=libreria
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POOL_SIZE=5
SQL_ECHO=false
