# Copiar a `.env` (sin punto en este archivo) y completar los valores.
# NO versionar `.env`. Ningún valor de este ejemplo es un secreto real.
POSTGRES_USER=libreria
POSTGRES_PASSWORD=cambiar_por_la_contrasena_local
POSTGRES_DB=libreria
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
ACCESS_TOKEN_TTL_MIN=30
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENCY=4
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEG=60
POOL_SIZE=5
SQL_ECHO=false
# Sólo para desarrollo local por HTTP; mantener true en producción.
COOKIE_SECURE=false
