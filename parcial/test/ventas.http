# C-16 fix — venta transaccional (C-10, C-11, C-12, RN-09, RN-10, RN-11,
# RN-13, RN-15 y el aviso de `BackgroundTasks`).
#
# Requisitos para ejecutar este archivo:
#   - API en http://127.0.0.1:8000 con PostgreSQL real y esquema al día.
#   - Un usuario VENDEDOR activo `c16-fix-vendedor@example.com` con la
#     contraseña `c16-fix-clave-123` (C-17/seed o el bootstrap de evidencia).
#   - Un cliente y tres libros con stock inicial cargado por el punto único
#     (`movimiento_stock` con motivo `Stock inicial`, RN-11):
#       * Rayuela      → stock >= 1, precio 45000.00
#       * Bestiario    → stock = 1,  precio 24000.00
#       * Libro de baja → `borrado_en IS NOT NULL`
#     Reemplazar los ids de las variables por los reales de la base.
#   - El invariante global debe partir en 0 filas:
#       SELECT l.id FROM libro l
#       LEFT JOIN movimiento_stock m ON m.libro_id = l.id
#       GROUP BY l.id, l.stock
#       HAVING l.stock <> COALESCE(SUM(m.cantidad), 0);
#
# La cookie viaja SÓLO en `Set-Cookie: access_token` (HttpOnly). El cliente
# REST conserva la cookie entre bloques del mismo archivo.

@host = http://127.0.0.1:8000
@vendedor_email = c16-fix-vendedor@example.com
@vendedor_password = c16-fix-clave-123
@cliente_id = 2001
@rayuela_id = 2002
@bestiario_id = 2003
@libro_baja_id = 2004
@cliente_inexistente = 999999999
@libro_inexistente = 999999999

### C-10 · login del vendedor -> 200 + cookie HttpOnly
# Esperado (cuerpo): {"mensaje":"Sesión iniciada","debe_cambiar_password":false,...}
# Esperado (cabecera): Set-Cookie: access_token=<jwt>; HttpOnly; Path=/; SameSite=lax
# RN-04 / C-11: la cookie es la única credencial.
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{vendedor_email}}",
  "password": "{{vendedor_password}}"
}

### C-10 · alta válida con dos renglones -> 201
# Cuerpo: cliente existente, Rayuela x1 y Bestiario x1 (hay stock).
# Esperado: 201 con
#   "total" = 1*45000.00 + 1*24000.00 = 69000.00
#   cada renglón con "precio_unitario" copiado de libro.precio
#   "cantidad" 1 y "subtotal" 45000.00 / 24000.00
#   stock de Rayuela y Bestiario descontado en 1
#   un movimiento_stock por renglón con cantidad -1, motivo 'Venta',
#   venta_id de la venta nueva y usuario_id del vendedor.
# RN-09, RN-10, RN-11.
# Después de la respuesta, en la consola de uvicorn debe aparecer:
#   WARNING libreria.avisos: Comprobante de la venta <id> enviado al cliente
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [
    { "libro_id": {{rayuela_id}}, "cantidad": 1 },
    { "libro_id": {{bestiario_id}}, "cantidad": 1 }
  ]
}

### C-10 · la variante sin barra final responde igual, sin 307
# Esperado: 201 con la misma forma de cuerpo; NO debe haber 307/redirect.
# RN-09, CV-08.
POST {{host}}/ventas
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [
    { "libro_id": {{rayuela_id}}, "cantidad": 1 }
  ]
}

### Control C-10 · venta, renglones, movimientos y stock
# Ejecutar en psql después del 201. La venta más reciente debe coincidir con
# el cuerpo devuelto; los movimientos deben ser negativos y del vendedor.
#   SELECT id, cliente_id, total, fecha
#     FROM venta ORDER BY id DESC LIMIT 1;              -- total = 69000.00
#   SELECT libro_id, cantidad, precio_unitario
#     FROM renglon_venta WHERE venta_id = <id> ORDER BY id;
#   SELECT libro_id, cantidad, motivo, usuario_id, venta_id
#     FROM movimiento_stock WHERE venta_id = <id> ORDER BY id;  -- cantidad < 0
#   SELECT id, stock FROM libro WHERE id IN ({{rayuela_id}}, {{bestiario_id}});
#   SELECT l.id FROM libro l
#     LEFT JOIN movimiento_stock m ON m.libro_id = l.id
#     GROUP BY l.id, l.stock
#     HAVING l.stock <> COALESCE(SUM(m.cantidad), 0);    -- 0 filas (RN-11)

### C-11 · Rayuela x1 (alcanza) + Bestiario x2 (hay 1) -> 409 sin escrituras
# Esperado: 409 {"detail":"Stock insuficiente para 'Bestiario'"}.
# No debe crecer ninguna fila de venta, renglon_venta ni movimiento_stock,
# y el stock de ambos libros debe quedar intacto.
# RN-10, RN-11, RN-13.
#
# Control C-11 (ejecutar ANTES y DESPUÉS; los tres conteos deben ser iguales):
#   SELECT (SELECT count(*) FROM venta) AS ventas,
#          (SELECT count(*) FROM renglon_venta) AS renglones,
#          (SELECT count(*) FROM movimiento_stock) AS movimientos;
#   SELECT id, stock FROM libro WHERE id IN ({{rayuela_id}}, {{bestiario_id}});
#   -- invariante: 0 filas
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [
    { "libro_id": {{rayuela_id}}, "cantidad": 1 },
    { "libro_id": {{bestiario_id}}, "cantidad": 2 }
  ]
}

### C-12 · cliente inexistente -> 409 sin escrituras
# Esperado: 409 {"detail":"El cliente indicado no existe"}.
# No usar 404 en el alta: el 404 pertenece a GET /ventas/{id}.
# RN-10, RN-13.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_inexistente}},
  "renglones": [ { "libro_id": {{rayuela_id}}, "cantidad": 1 } ]
}

### C-12 · libro inexistente -> 409 sin escrituras
# Esperado: 409 {"detail":"Uno o más libros indicados no existen"}.
# RN-10, RN-13.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [ { "libro_id": {{libro_inexistente}}, "cantidad": 1 } ]
}

### C-12 · libro dado de baja -> 409 sin escrituras
# Esperado: 409 {"detail":"El libro '<título>' está dado de baja"}.
# RN-10, RN-13.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [ { "libro_id": {{libro_baja_id}}, "cantidad": 1 } ]
}

### Control C-12 · mismas consultas de C-11
# Los tres 409 deben dejar venta/renglon_venta/movimiento_stock sin cambios,
# el stock intacto y el invariante en 0 filas.
#   SELECT (SELECT count(*) FROM venta) AS ventas,
#          (SELECT count(*) FROM renglon_venta) AS renglones,
#          (SELECT count(*) FROM movimiento_stock) AS movimientos;
#   SELECT l.id FROM libro l
#     LEFT JOIN movimiento_stock m ON m.libro_id = l.id
#     GROUP BY l.id, l.stock
#     HAVING l.stock <> COALESCE(SUM(m.cantidad), 0);

### C-16 fix · libro repetido con cliente inexistente -> 409 (no 422)
# El orden es 401 -> 403 -> 409 -> 422: la existencia gana al contrato.
# Esperado: 409 {"detail":"El cliente indicado no existe"}.
# RN-09, CV-08.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_inexistente}},
  "renglones": [
    { "libro_id": {{rayuela_id}}, "cantidad": 1 },
    { "libro_id": {{rayuela_id}}, "cantidad": 1 }
  ]
}

### C-16 fix · libro repetido con stock agregado suficiente -> 422
# Suma 2 <= stock; el contrato de renglones gana. Sin escrituras.
# Esperado: 422 {"detail":"No se puede incluir el mismo libro dos veces en una venta"}.
# RN-09.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [
    { "libro_id": {{rayuela_id}}, "cantidad": 1 },
    { "libro_id": {{rayuela_id}}, "cantidad": 1 }
  ]
}

### C-16 fix · ID fuera del rango BIGINT -> 422 (nunca 500)
# Esperado: 422 con detail[0].msg = "El valor supera el máximo permitido"
# y sin texto de PostgreSQL. No se escribe ninguna fila.
# RN-15.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": 1000000000000000000000000000000,
  "renglones": [ { "libro_id": {{rayuela_id}}, "cantidad": 1 } ]
}

### C-16 fix · cantidad booleana -> 422 (strict, nunca se coacciona a 1)
# Esperado: 422 con detail[0].msg = "Debe ser un número entero válido".
# RN-15.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [ { "libro_id": {{rayuela_id}}, "cantidad": true } ]
}

### C-16 fix · cantidad fuera del rango integer -> 422
# Esperado: 422 con detail[0].msg = "El valor supera el máximo permitido".
# RN-15.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "renglones": [ { "libro_id": {{rayuela_id}}, "cantidad": 2147483648 } ]
}

### C-16 fix · campo extra `precio` -> 422
# Esperado: 422 con detail[0].msg = "El campo no está permitido".
# RN-09, RN-15.
POST {{host}}/ventas/
Content-Type: application/json

{
  "cliente_id": {{cliente_id}},
  "precio": 1,
  "renglones": [ { "libro_id": {{rayuela_id}}, "cantidad": 1 } ]
}

### Control final · invariante global en 0 filas
#   SELECT l.id FROM libro l
#     LEFT JOIN movimiento_stock m ON m.libro_id = l.id
#     GROUP BY l.id, l.stock
#     HAVING l.stock <> COALESCE(SUM(m.cantidad), 0);
# -> 0 filas (RN-11, CHECKLIST §4).
